# ===== 服务端专用 · 绝不进 Git =====
# 复制本文件为 .env 后填入真实值：
#   cp .env.example .env
# 填完请先跑：node ../../tools/verify-volc.mjs
# 确认全部 [OK] 之后再动前端代码。

# ---------------------------------------------------------------
# 一、豆包语音（语音识别 ASR）
# 来源：https://console.volcengine.com  ->  豆包语音 -> API Key 管理
# 【新版控制台】只需要这一条：
VOLC_API_KEY=
# 【旧版控制台】才需要下面两条（新版请留空）
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=

# 资源 ID：录音文件识别 2.0，不要改
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
VOLC_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLC_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query

# ---------------------------------------------------------------
# 二、火山方舟（豆包大模型 · 负责生成简介）
# 来源：https://console.volcengine.com/ark  ->  API Key 管理
# 注意：这里要方舟自己的 API Key，不能填上面的语音 Key，更不能填 AK/SK
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 必须是 ep- 开头的推理接入点 ID，不是 doubao-xxx 模型名
ARK_ENDPOINT_ID=

# ---------------------------------------------------------------
# 三、IAM 云密钥（一般不需要）
# 只有在服务端要做 SigV4 签名时才用。留空即可，别为了"完整"去创建。
VOLC_AK=
VOLC_SK=

# ---------------------------------------------------------------
# 服务端自身
PORT=3000
JWT_SECRET=
